{
  "name": "mcp-component-docs",
  "version": "0.1.0",
  "description": "MCP server — scan a React/TypeScript component library and generate accurate prop documentation via the TypeScript compiler",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "mcp-component-docs": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ts-morph": "^28.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0"
  },
  "author": "Rahul Kumar <https://github.com/RahulTinku>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RahulTinku/mcp-devtools.git",
    "directory": "packages/component-docs"
  },
  "homepage": "https://github.com/RahulTinku/mcp-devtools/tree/main/packages/component-docs#readme",
  "bugs": {
    "url": "https://github.com/RahulTinku/mcp-devtools/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "react",
    "typescript",
    "component-docs",
    "props",
    "documentation",
    "claude",
    "developer-tools"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
