{
  "name": "@mcp-devtools/accessibility",
  "version": "0.1.0",
  "description": "MCP server — run axe-core accessibility audits on any URL via Playwright",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "mcp-accessibility": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "postinstall": "playwright install chromium 2>/dev/null || true"
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "dependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright": "^1.60.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
